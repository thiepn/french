import assert from 'node:assert/strict';
import {SOURCES,sourceId,immutableRef,lexicalCrosswalk,isReviewedLink} from '../app/src/core/unified/source.ts';
import {COURSE_META,COURSE_SESSIONS,GRAMMAR_REFS,UNIT_IDS,validateCourseIndex} from '../app/src/core/unified/catalog.ts';
import {previewLegacyImport} from '../app/src/core/unified/preflight.ts';
assert.deepEqual(validateCourseIndex(),[]);
assert.equal(COURSE_SESSIONS.length,60);assert.equal(GRAMMAR_REFS.length,72);assert.equal(UNIT_IDS.length,12);
assert.equal(COURSE_SESSIONS.filter(x=>x.kind==='lesson').length,48);
assert.deepEqual(COURSE_SESSIONS.filter(x=>x.checkpoint).map(x=>x.id),['S10','S20','S30','S40','S50','S60']);
assert.equal(COURSE_SESSIONS[0].pdfPage,36);assert.equal(COURSE_META.declaredPdfPages,653);
assert.equal(COURSE_META.canPublishLessons,false);
assert.ok(Object.values(SOURCES).every(x=>!x.canPublishRaw&&!x.canPublishDerived));
assert.ok(immutableRef('lcf','lesson','L01').endsWith('@'+SOURCES.lcf.commit));
assert.equal(sourceId('f22','card','1.1001'),'fru1:f22:card:1.1001');
assert.throws(()=>sourceId('lcf','session','../bad'),/INVALID_SOURCE_ID/);
const single=lexicalCrosswalk([{source:'lcf',id:'1',form:'café',senseId:'a'}],[{source:'french',id:'2',form:'café',senseId:'b'}]);
assert.equal(single[0].status,'CANDIDATE');assert.equal(single[0].automaticMerge,false);
const ambiguous=lexicalCrosswalk([{source:'lcf',id:'1',form:'venir'}],[{source:'french',id:'2',form:'venir'},{source:'french',id:'3',form:'venir'}]);
assert.equal(ambiguous[0].status,'AMBIGUOUS');assert.equal(ambiguous[0].automaticMerge,false);
const review={source:'fru1:lcf:vocab:1',target:'fru1:french:vocab:2',sourceSense:'s1',targetSense:'s2',reviewEvidenceId:'r1',approved:true};
assert.equal(isReviewedLink(review),true);assert.equal(isReviewedLink({...review,approved:false}),false);
const lcf=await previewLegacyImport(JSON.stringify({state:{schema:1,course:{currentSession:15,coveredThroughSession:10},stats:{attempted:5},mistakes:[{id:1}]}}),'lcf');
assert.equal(lcf.status,'VALID_PREVIEW');assert.equal(lcf.writeAllowed,false);assert.equal(lcf.items,1);
assert.equal(lcf.newSrsReviews,0);assert.equal(lcf.newCefrAwards,0);
const f22=await previewLegacyImport(JSON.stringify({progress:{'1001':{seen:2,ease:2.5},'2':{seen:1}},settings:{direction:'frde'}}),'f22');
assert.equal(f22.status,'VALID_PREVIEW');assert.equal(f22.items,2);assert.equal(f22.writeAllowed,false);
assert.equal((await previewLegacyImport(JSON.stringify({schema:2,course:{currentSession:1,coveredThroughSession:0}}),'lcf')).status,'REJECTED');
assert.equal((await previewLegacyImport('{"progress":{"../":{"seen":1}}}','f22')).status,'REJECTED');
assert.equal((await previewLegacyImport('not-json','lcf')).status,'REJECTED');
assert.equal((await previewLegacyImport('a'.repeat(8*1024*1024+1),'lcf')).status,'REJECTED');
assert.equal((await previewLegacyImport('{"schema":1,"__proto__":{},"course":{"currentSession":1,"coveredThroughSession":0}}','lcf')).status,'REJECTED');
console.log(JSON.stringify({schema:'thiepn-french-u1-contract-test',ok:true,sessionCount:60,grammarCount:72,rightsHeld:true,automaticMerges:0,importWrites:0}));
