import assert from 'node:assert/strict';
import {SOURCES,sourceId,provenance,distributionAllowed} from '../app/src/core/unified/source.ts';
import {COURSE_SESSIONS,findCourseSession,ORIGINAL_GRAMMAR,CARNET_GRAMMAR_COUNT} from '../app/src/core/unified/catalog.ts';
import {normalizeFrenchSurface,crosswalkWithLosses} from '../app/src/core/unified/crosswalk.ts';
import {preflightLegacyJson} from '../app/src/core/unified/preflight.ts';

assert.equal(COURSE_SESSIONS.length,60);
assert.equal(new Set(COURSE_SESSIONS.map(item=>item.source.qualifiedId)).size,60);
assert.equal(findCourseSession(60)?.position,60);
assert.equal(findCourseSession(0),null);
assert.equal(findCourseSession(61),null);
assert.equal(findCourseSession(1.5),null);
assert.ok(COURSE_SESSIONS.every(item=>item.availability==='source-reference-only'&&item.source.rights==='review-required'));
assert.equal(CARNET_GRAMMAR_COUNT,72);
assert.ok(ORIGINAL_GRAMMAR.length>=8);
assert.ok(ORIGINAL_GRAMMAR.every(item=>item.source.source==='original'&&item.prompt&&item.answer));
assert.equal(distributionAllowed('carnet'),false);
assert.equal(distributionAllowed('french22'),false);
assert.equal(distributionAllowed('native'),true);
assert.equal(SOURCES.native.revision,'74dc6fcf8eaa1b1b7a0ef6ea9f3d92625d5ee31f');
assert.equal(sourceId('carnet','session','position-001'),COURSE_SESSIONS[0].source.qualifiedId);
assert.notEqual(sourceId('carnet','lexeme','1001'),sourceId('french22','lexeme','1001'));
assert.notEqual(sourceId('native','lexeme','1001'),sourceId('carnet','lexeme','1001'));
assert.deepEqual(provenance('carnet','grammar','a'),provenance('carnet','grammar','a'));
assert.throws(()=>sourceId('carnet','session','../unsafe?'),/Invalid/);
assert.equal(normalizeFrenchSurface(' Où  '),'où');
assert.notEqual(normalizeFrenchSurface('ou'),normalizeFrenchSurface('où'),'accents must preserve lexical distinctions');

const a={source:'carnet' as const,localId:'1',form:'livre',senseId:'book',partOfSpeech:'noun'};
const b={source:'french22' as const,localId:'1',form:'livre',senseId:'book',partOfSpeech:'noun'};
const candidate=crosswalkWithLosses([a],[b]);
assert.equal(candidate.totals.candidateOnly,1);
assert.equal(candidate.verifiedSenseEquivalences,0);
assert.equal(candidate.progressImported,false);
assert.equal(candidate.rows[0].disposition,'candidate-only');
assert.equal(crosswalkWithLosses([a],[b,{...b,localId:'2'}]).totals.ambiguous,1);
assert.equal(crosswalkWithLosses([{...a,senseId:undefined}],[b]).totals.insufficientSense,1);
assert.equal(crosswalkWithLosses([a],[{...b,form:'fleur'}]).totals.unmatched,1);
assert.equal(crosswalkWithLosses([a],[]).totals.unmatched,1);
assert.equal(crosswalkWithLosses([a,a], [b]).totals.ambiguous,2);
assert.equal(crosswalkWithLosses([a],[b,{...b,localId:'2',form:'fleur'}]).totals.unusedTargets,1);
const inspected=preflightLegacyJson(JSON.stringify({storageKey:'fr-a1a2-practice-v6',progress:{a:1},reviews:[{id:2}]}),'carnet');
assert.equal(inspected.status,'inspectable');
assert.equal(inspected.readOnly,true);
assert.equal(inspected.readyForImport,false);
assert.equal(inspected.recordEstimate,1);
assert.equal(preflightLegacyJson('oops','carnet').status,'blocked');
assert.equal(preflightLegacyJson('[]','carnet').status,'blocked');
assert.equal(preflightLegacyJson('{"storageKey":"wrong","progress":{}}','carnet').status,'blocked');
assert.equal(preflightLegacyJson('{"cards":[],"unsafe_field":1}','french22').status,'blocked');
assert.equal(preflightLegacyJson(JSON.stringify({data:[1],storageKey:'french_flashcards_L15_28_v1'}),'french22').status,'inspectable');
assert.equal(preflightLegacyJson(' '.repeat(5*1024*1024+1),'carnet').status,'blocked');
console.log('U1 deterministic source, catalog, crosswalk and preflight regressions PASS');
